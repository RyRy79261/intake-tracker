{
  "name": "@intake/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm db:migrate && next build",
    "start": "next start",
    "cap:export": "node scripts/cap-build.js",
    "lint": "eslint --max-warnings 0 src e2e playwright.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:tz:sa": "TZ=Africa/Johannesburg vitest run",
    "test:tz:de": "TZ=Europe/Berlin vitest run",
    "test:tz": "pnpm test:tz:sa && pnpm test:tz:de",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "bench": "vitest bench",
    "bench:ci": "BENCH_WRITE_BASELINE=1 vitest bench --run",
    "seed:dev": "tsx scripts/seed-dev-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset-neon-db.ts",
